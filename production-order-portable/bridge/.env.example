# Bridge HTTP port (same as MES API when replacing bsq-admin)
PORT=8080

# MySQL (bsq-mes database). Leave DB_HOST empty to use mock workorder mode.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=bsq-mes

# Mock mode (when DB_HOST is empty)
MOCK_WORKORDER_ID=1
MOCK_PLAN_QTY=1

# MQTT / ActiveMQ (must match ThingsBoard or device subscription)
MQTT_ENABLED=true
MQTT_HOST=tcp://127.0.0.1:1893
MQTT_USERNAME=bsqmes
MQTT_PASSWORD=123456
MQTT_PUBLISH_TOPIC=SubTopic1
MQTT_QOS=0
MQTT_RETAIN=true
